# DLA Access Enterprise - Environment Variables
# Copy this file to .env and configure

# Application
APP_NAME=DLA Access Enterprise
ENVIRONMENT=development
DEBUG=true

# Security (CHANGE IN PRODUCTION)
SECRET_KEY=change-this-to-a-secure-random-string
ENCRYPTION_KEY=change-this-encryption-key

# Database
DATABASE_URL=postgresql+asyncpg://dla:dla_password@localhost:5432/dla_access_enterprise

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Geolocation
GOOGLE_MAPS_API_KEY=

# AI
AI_API_KEY=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
